# Copie para .env.local e preencha. Em projetos ligados à Vercel: `vercel env pull .env.local`.

# Banco (Neon)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Sessão (JWT). Gere com: openssl rand -base64 32
AUTH_SECRET=

# Uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM="Luumu <onboarding@resend.dev>"
SALES_EMAIL=

# Cron da Vercel (/api/cron/reports)
CRON_SECRET=

# URL pública do app (opcional; padrão: URL da Vercel ou localhost)
NEXT_PUBLIC_APP_URL=

# IA (Insights). Padrão: Groq. Para outro provedor compatível com OpenAI use AI_*.
GROQ_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODEL=

# Report Quinzenal: id do usuário autorizado (opcional)
PRODUCT_REPORT_USER_ID=
